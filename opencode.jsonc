{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    // Broad rule first: V2 uses last-match-wins, so defaults prompt the user.
    { "action": "shell", "resource": "*", "effect": "ask" },
    // Hard blocks — must stay AFTER the broad rule to take precedence.
    { "action": "shell", "resource": "git push*", "effect": "deny" }
  ]
}
